---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import defaultCover from "../assets/covers/default.webp";
import ProfileLinks from "../components/ProfileLinks.astro";
import SearchDialog from "../components/SearchDialog.astro";
import "../styles/site.css";
interface Props { title?: string; description?: string; section?: "home" | "posts" | "about"; canonicalPath?: string; image?: ImageMetadata; type?: "website" | "article"; }
const { title, description = "김도현(D0HY30N)이 모의해킹과 사이버보안을 공부하며 남긴 기록.", section, canonicalPath = Astro.url.pathname, image = defaultCover, type = "website" } = Astro.props;
const name = "D0HY30N's Blog";
const pageTitle = title ? title + " · " + name : name;
const canonical = new URL(canonicalPath, Astro.site);
// Share previews (KakaoTalk, Slack, X) handle JPEG most reliably.
const shareImage = await getImage({ src: image, width: Math.min(image.width, 1200), format: "jpg" });
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=d0-refined" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={name} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site)} />
    <meta property="og:image:width" content={String(shareImage.attributes.width)} />
    <meta property="og:image:height" content={String(shareImage.attributes.height)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>try { document.documentElement.dataset.theme = localStorage.getItem("theme") || ""; } catch {}</script>
  </head>
  <body>
    <a class="skip" href="#main">본문으로 이동</a>
    <header class="site-head" id="top" tabindex="-1">
      <div class="bar frame">
        <a class="brand" href="/" aria-label="D0HY30N 홈">
          <span class="brand-mark" aria-hidden="true">d0</span>
          <span class="brand-name">D0HY30N</span>
        </a>
        <nav class="nav" aria-label="주 메뉴">
          <a href="/" aria-current={section === "home" ? "page" : undefined}>Home</a>
          <a href="/archive/" aria-current={section === "posts" ? "location" : undefined}>Posts</a>
          <a href="/about/" aria-current={section === "about" ? "page" : undefined}>About</a>
        </nav>
        <div class="tools">
          <button id="search-open" type="button" aria-label="글 검색" aria-haspopup="dialog" aria-controls="search"><span class="glass" aria-hidden="true"></span><span class="search-label">검색</span></button>
          <button id="theme-switch" type="button" aria-label="다크 모드" aria-pressed="false"><span class="theme-icon" aria-hidden="true"></span></button>
        </div>
      </div>
    </header>
    <main class="frame" id="main"><slot /></main>
    <footer class="site-foot" id="footer">
      <div class="frame foot-inner">
        <ProfileLinks />
        <small>© {new Date().getFullYear()} <a href="/" aria-label={name + " 홈"}>D0HY30N</a>. All rights reserved.</small>
      </div>
    </footer>
    <SearchDialog />
    <script>
      const themeSwitch = document.querySelector<HTMLButtonElement>("#theme-switch")!;
      const systemTheme = matchMedia("(prefers-color-scheme: dark)");
      const isDark = () => document.documentElement.dataset.theme
        ? document.documentElement.dataset.theme === "dark" : systemTheme.matches;
      function showTheme() { themeSwitch.setAttribute("aria-pressed", String(isDark())); }
      themeSwitch.addEventListener("click", () => {
        const theme = isDark() ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        try { localStorage.setItem("theme", theme); } catch {}
        showTheme();
      });
      systemTheme.addEventListener("change", showTheme);
      showTheme();
    </script>
  </body>
</html>
