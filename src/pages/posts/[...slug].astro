---
import PostArticle from "../../components/PostArticle.astro";
import { listPosts, postsWithNeighbors } from "../../lib/posts";

export async function getStaticPaths() {
  return postsWithNeighbors(await listPosts()).map(props => ({
    params: { slug: props.post.id }, props,
  }));
}
---
<PostArticle {...Astro.props} />
