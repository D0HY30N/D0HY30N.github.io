---
import cmsIconFont from "@fontsource-variable/material-symbols-outlined/files/material-symbols-outlined-latin-wght-normal.woff2?url";
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="same-origin" />
    <title>글 관리 · D0HY30N's Blog</title>
    <link href="config.yml" type="text/yaml" rel="cms-config-url" />
    <link rel="preload" href={cmsIconFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body data-pagefind-ignore>
    <noscript>글 관리 화면을 사용하려면 JavaScript를 켜 주세요.</noscript>
    <script is:inline>window.CMS_MANUAL_INIT = true;</script>
    <script is:inline src="https://unpkg.com/@sveltia/cms@0.211.4/dist/sveltia-cms.js"></script>
    <script>
      import { registerBlogPreviews } from "../scripts/cms-preview";

      registerBlogPreviews();
    </script>
  </body>
</html>
