---
import Shell from "../layouts/Shell.astro";
---
<Shell title="페이지를 찾을 수 없어요" description="요청한 페이지를 찾을 수 없어요.">
  <header class="page-heading not-found">
    <h1>404<span>.</span></h1>
    <p>요청한 페이지가 없거나 주소가 바뀌었어요.</p>
    <div class="actions">
      <a href="/">홈으로</a>
      <a href="/archive/">전체 글 보기</a>
    </div>
  </header>
</Shell>

<style>
  .not-found p { margin-top: 1.25rem; color: var(--secondary); font-size: clamp(1rem, 1.5vw, 1.15rem); line-height: 1.7; }
  .actions { display: flex; flex-wrap: wrap; gap: .55rem; margin-top: 2rem; }
  .actions a {
    display: inline-flex; align-items: center; min-height: 44px; padding-inline: 1.1rem;
    border: 1px solid var(--rule); border-radius: 2rem; color: var(--secondary); font-size: .92rem;
  }
  .actions a:first-child { border-color: var(--accent); color: var(--accent); background: var(--tint); }
  .actions a:hover { border-color: var(--accent); color: var(--accent); }
</style>
