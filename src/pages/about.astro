---
import Shell from "../layouts/Shell.astro";
import ProfileEntries from "../components/ProfileEntries.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { awardsAndActivities, certifications, cves, positions } from "../data/profile";

const byDateDesc = [...awardsAndActivities].sort((a, b) => b.date.localeCompare(a.date));
// Career first so the job is the first thing under the name; everything is visible without clicking.
const sections = [
  { id: "experience", title: "경력", entries: [...positions].sort((a, b) => b.start.localeCompare(a.start)) },
  { id: "awards", title: "수상", count: true, entries: byDateDesc.filter(entry => entry.prize) },
  { id: "cves", title: "CVE", count: true, entries: [...cves].sort((a, b) => b.published.localeCompare(a.published)) },
  { id: "activities", title: "활동", entries: byDateDesc.filter(entry => !entry.prize) },
  { id: "certifications", title: "자격증", entries: certifications },
].filter(section => section.entries.length > 0);
---
<Shell title="About" section="about" description="김도현(D0HY30N)의 CVE, 수상, 활동, 경력과 자격증.">
  <header class="page-heading profile">
    <p class="eyebrow">About<span>.</span></p>
    <h1>김도현 <span class="handle">/ D0HY30N</span></h1>
    <p class="motto" lang="en">“The gratification comes in the doing, not in the results.”</p>
    <ProfileLinks besideName />
    <span class="imprint" aria-hidden="true"></span>
  </header>

  <div class="portfolio">
    {sections.map(({ id, title, entries, count }) => <section id={id} aria-labelledby={id + "-title"}>
      <h2 id={id + "-title"}>
        {title}
        {count && <span class="section-count">{entries.length}건</span>}
      </h2>
      <ProfileEntries entries={entries} />
    </section>)}
  </div>
</Shell>

<style>
  /*! Spectral by The Spectral Project Authors. SIL OFL 1.1: /fonts/Spectral-OFL.txt */
  @font-face {
    font-family: "Spectral";
    src: url("../assets/fonts/spectral-latin-500-italic.woff2") format("woff2");
    font-weight: 500;
    font-style: italic;
    font-display: swap;
  }
  .profile {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: start;
    column-gap: 2rem; margin-bottom: clamp(2.5rem, 5vw, 3.25rem);
  }
  .profile > :not(.imprint) { grid-column: 1; }
  .eyebrow { color: var(--ink); font-size: 1.875rem; font-weight: 750; letter-spacing: -.04em; }
  .eyebrow span { color: var(--accent); }
  .profile h1 {
    margin-top: .5rem; font-size: clamp(2.5rem, 5.5vw, 4rem); line-height: 1.12; letter-spacing: -.035em;
  }
  .handle {
    color: var(--secondary); font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    font-weight: 400; letter-spacing: -.02em; white-space: nowrap;
  }
  .motto {
    margin-top: .6rem; color: var(--secondary);
    font-family: "Spectral", Georgia, serif; font-size: 1rem; font-weight: 500; font-style: italic; line-height: 1.5; text-wrap: balance;
  }
  .profile :global(.profile-links) { margin-top: 1.25rem; }
  .imprint {
    grid-column: 2; grid-row: 1 / span 5; align-self: center; position: relative;
    width: clamp(6.5rem, 12vw, 9rem); aspect-ratio: 1; margin-inline-end: clamp(0rem, 4vw, 3.5rem);
  }
  .imprint::before {
    content: ""; position: absolute; inset: 0; border-radius: 50%; transform: rotate(-24deg);
    background: repeating-radial-gradient(ellipse 66% 94% at 28% 62%,
      transparent 0 5px, var(--accent) 5.5px 6.75px, transparent 7.25px 9px);
  }
  .imprint::after {
    content: ""; position: absolute; inset: auto 3% 9% auto; width: 10%; aspect-ratio: 1;
    border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 .28rem var(--paper);
  }
  .portfolio {
    --record-rail: clamp(10rem, 18vw, 11rem);
    --record-gap: clamp(.85rem, 2vw, 1.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .portfolio section { min-width: 0; padding-bottom: .75rem; border-top: 1px solid var(--rule); word-break: keep-all; overflow-wrap: anywhere; scroll-margin-top: 1rem; }
  .portfolio h2 {
    display: flex; align-items: baseline; gap: .65rem; padding-block: 1.5rem .5rem;
    font-size: clamp(1.35rem, 2vw, 1.65rem); line-height: 1.35; letter-spacing: -.025em;
  }
  .section-count { color: var(--secondary); font-size: .86rem; font-weight: 400; letter-spacing: 0; font-variant-numeric: tabular-nums; }
  @media (max-width: 40rem) {
    .profile { grid-template-columns: minmax(0, 1fr); }
    /* The fingerprint is decoration; on phones it only crowds the name. */
    .imprint { display: none; }
  }
</style>
