---
import Shell from "../layouts/Shell.astro";
import RecentPosts from "../components/RecentPosts.astro";
import { listPosts } from "../lib/posts";
const posts = await listPosts();
---
<Shell section="home">
  <header class="intro">
    <h1>D0HY30N's <span>Blog.</span></h1>
    <p lang="en">Personal Notes on Cybersecurity</p>
  </header>
  <section aria-labelledby="latest">
    <div class="section-head"><h2 id="latest">최근 글</h2><a class="view-all" href="/archive/">전체보기 <span aria-hidden="true">→</span></a></div>
    <RecentPosts posts={posts.slice(0, 6)} />
  </section>
</Shell>
