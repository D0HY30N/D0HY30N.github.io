---
import { commentsConfig } from "../config";
import { url } from "../utils/url-utils";

// The canonical pathname keeps ALL/category views attached to the same thread.
const term = Astro.url.pathname;
const themeOrigin = Astro.site ?? Astro.url;
---

{commentsConfig.enabled && (
    <post-comments id="comments" aria-label="댓글" data-pagefind-ignore
        data-light-theme={new URL(url("/comments/light.css"), themeOrigin).href + "?v=2"}
        data-dark-theme={new URL(url("/comments/dark.css"), themeOrigin).href + "?v=2"}
        class="block w-full px-6 md:px-9 mt-6 mb-6">
        <div class="comments-content">
            <template>
                <giscus-widget
                    id="comments-thread"
                    repo={commentsConfig.repo}
                    repoid={commentsConfig.repoId}
                    category={commentsConfig.category}
                    categoryid={commentsConfig.categoryId}
                    mapping="specific"
                    term={term}
                    strict="1"
                    reactionsenabled="0"
                    emitmetadata="0"
                    inputposition="top"
                    lang="ko"
                    loading="lazy"
                ></giscus-widget>
            </template>
            <div data-comments-mount></div>
            <details class="comments-help">
                <summary>내 댓글 수정·삭제 방법</summary>
                <p>댓글의 작성 시간을 누르면 GitHub로 이동해요. 본인 계정으로 로그인한 뒤, 내 댓글의 ⋯ 메뉴에서 Edit(수정) 또는 Delete(삭제)를 선택하세요.</p>
            </details>
            <noscript>
                <p class="text-50 text-sm">댓글을 보려면 자바스크립트를 활성화해 주세요.</p>
            </noscript>
        </div>
    </post-comments>
)}

<style>
    .comments-content {
        border-top: 1px solid var(--line-divider);
        padding-top: 1.75rem;
    }

    giscus-widget {
        display: block;
        width: 100%;
    }

    .comments-help {
        margin-top: 1rem;
        color: #707781;
        font-size: 0.8125rem;
        line-height: 1.7;
    }

    :global(.dark) .comments-help {
        color: #a1a1aa;
    }

    .comments-help summary {
        width: fit-content;
        margin-left: auto;
        cursor: pointer;
    }

    .comments-help summary:hover {
        color: var(--primary);
    }

    .comments-help p {
        max-width: 30rem;
        margin: 0.5rem 0 0 auto;
    }

    giscus-widget::part(iframe) {
        display: block;
        width: 100%;
        border: 0;
    }
</style>

<script>
import "giscus";

class PostComments extends HTMLElement {
    private themeObserver?: MutationObserver;

    connectedCallback() {
        // Create a fresh widget after Swup restores a page from its cache.
        // giscus removes its message listener when the old widget disconnects.
        const template = this.querySelector("template");
        const mount = this.querySelector("[data-comments-mount]");
        if (!template || !mount) return;

        const fragment = template.content.cloneNode(true) as DocumentFragment;
        const widget = fragment.querySelector("giscus-widget");
        if (!widget) return;

        const syncTheme = () => {
            const path = document.documentElement.classList.contains("dark")
                ? this.dataset.darkTheme
                : this.dataset.lightTheme;
            if (path) widget.setAttribute("theme", new URL(path, location.origin).href);
        };

        syncTheme();
        mount.replaceChildren(fragment);
        this.themeObserver?.disconnect();
        this.themeObserver = new MutationObserver(syncTheme);
        this.themeObserver.observe(document.documentElement, {
            attributes: true,
            attributeFilter: ["class"],
        });
    }

    disconnectedCallback() {
        this.themeObserver?.disconnect();
    }
}

if (!customElements.get("post-comments")) {
    customElements.define("post-comments", PostComments);
}
</script>
