---
import { Icon } from "astro-icon/components";
import { type NavBarLink } from "../../types/config";
import { url } from "../../utils/url-utils";
import Categories from "./Categories.astro";
import SidebarImage from "./SidebarImage.astro";

interface Props {
	links: NavBarLink[];
}

const links = Astro.props.links;
---
<div id="nav-menu-panel" class="mobile-nav-panel float-panel float-panel-closed absolute right-4 border border-black/[0.06] dark:border-white/10 md:hidden"
    role="region" aria-label="Mobile menu" aria-hidden="true" inert>
    <div class="px-2 pt-5">
        <SidebarImage id="mobile-menu-image" class="mb-2" />
        <Categories id="mobile-menu-categories" />
    </div>
    <nav aria-label="Mobile navigation" class="mx-4 mb-3 flex gap-1 border-t border-black/10 dark:border-white/10 pt-2">
    {links.map((link) => (
        <a href={link.external ? link.url : url(link.url)} class="group flex min-h-11 flex-1 justify-center items-center px-2 rounded-lg gap-1.5
            hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition
        "
           target={link.external ? "_blank" : null}
           rel={link.external ? "noopener noreferrer" : undefined}
        >
            <span class="transition text-base text-90 font-medium group-hover:text-[var(--primary)] group-active:text-[var(--primary)]">
                {link.name}
            </span>
            {link.external && <Icon name="fa6-solid:arrow-up-right-from-square"
                  class="transition text-[0.65rem] text-black/40 dark:text-white/40"
            >
            </Icon>}
        </a>
    ))}
    </nav>
</div>

<style>
    .mobile-nav-panel {
        width: min(21rem, calc(100vw - 2rem));
        max-height: calc(100vh - 6.25rem);
        max-height: calc(100dvh - 6.25rem);
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: thin;
    }

    .mobile-nav-panel :global(widget-layout) {
        display: block;
        background: transparent;
        border-radius: 0;
    }

    .mobile-nav-panel :global(a) {
        min-height: 44px;
    }

    .mobile-nav-panel :global(a:focus-visible) {
        outline: 2px solid var(--primary);
        outline-offset: -2px;
    }

    @media (prefers-reduced-motion: reduce) {
        .mobile-nav-panel {
            transition: none;
        }
    }
</style>

<script>
    const menuButton = document.getElementById("nav-menu-switch");
    const menuPanel = document.getElementById("nav-menu-panel");

    if (menuButton && menuPanel) {
        const desktop = window.matchMedia("(min-width: 768px)");
        const isOpen = () => menuButton.getAttribute("aria-expanded") === "true";
        const setOpen = (open: boolean, returnFocus = false) => {
            menuButton.setAttribute("aria-expanded", String(open));
            menuPanel.classList.toggle("float-panel-closed", !open);
            menuPanel.setAttribute("aria-hidden", String(!open));
            menuPanel.inert = !open;
            if (returnFocus) menuButton.focus({ preventScroll: true });
        };

        menuButton.addEventListener("click", () => setOpen(!isOpen()));
        menuPanel.addEventListener("click", (event) => {
            if (event.target instanceof Element && event.target.closest("a[href]")) {
                setOpen(false, true);
            }
        });
        document.addEventListener("click", (event) => {
            if (event.target instanceof Node && !menuPanel.contains(event.target) && !menuButton.contains(event.target)) {
                setOpen(false);
            }
        });
        document.addEventListener("focusin", (event) => {
            if (isOpen() && event.target instanceof Node && !menuPanel.contains(event.target) && !menuButton.contains(event.target)) {
                setOpen(false);
            }
        });
        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape" && isOpen()) setOpen(false, true);
        });
        desktop.addEventListener("change", () => {
            if (desktop.matches) setOpen(false);
        });

        const closeOnNavigation = () => window.swup.hooks.on("visit:start", () => setOpen(false));
        if (window.swup?.hooks) closeOnNavigation();
        else document.addEventListener("swup:enable", closeOnNavigation, { once: true });
    }
</script>
