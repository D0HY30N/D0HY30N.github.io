---
import { sidebarImageConfig } from "../../config";
import { url } from "../../utils/url-utils";

interface Props {
	class?: string;
	style?: string;
}

const { style } = Astro.props;
const className = Astro.props.class;
const { enable, src, darkSrc, alt, position = "center" } = sidebarImageConfig;
const imageSrc = src.trim();
const darkImageSrc = darkSrc?.trim();
const imageUrl = (source: string) => source.startsWith("/") ? url(source) : source;
---

{enable && imageSrc && (
    <div id="sidebar-image" class:list={[
        "relative aspect-square w-full max-w-[128px] mx-auto",
        className,
    ]} style={style}>
        <img src={imageUrl(imageSrc)} alt={alt} width="128" height="128" decoding="async"
            class:list={["absolute inset-0 w-full h-full object-contain", darkImageSrc && "dark:hidden"]}
            style={{ objectPosition: position }} />
        {darkImageSrc && (
            <img src={imageUrl(darkImageSrc)} alt={alt} width="128" height="128" decoding="async"
                class="hidden dark:block absolute inset-0 w-full h-full object-contain"
                style={{ objectPosition: position }} />
        )}
    </div>
)}
