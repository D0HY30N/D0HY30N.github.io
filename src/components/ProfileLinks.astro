---
interface Props { besideName?: boolean; }
const { besideName = false } = Astro.props;
---
<nav class={besideName ? "profile-links" : "foot-links"} aria-label={besideName ? "프로필 링크" : "소셜 프로필"}>
  <a href="https://github.com/D0HY30N" aria-label="GitHub 프로필" title="GitHub">
    {besideName && <span class="social-label">GitHub <span aria-hidden="true">↗</span></span>}
    <svg class="social-icon" viewBox="0 0 16 16" width="20" height="20" aria-hidden="true" fill="currentColor">
      <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.42 7.42 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
    </svg>
  </a>
  <a href="https://www.linkedin.com/in/dohyeon-kim-3bb505304/" aria-label="LinkedIn 프로필" title="LinkedIn">
    {besideName && <span class="social-label">LinkedIn <span aria-hidden="true">↗</span></span>}
    <svg class="social-icon" viewBox="0 0 448 512" width="19" height="21" aria-hidden="true" fill="currentColor">
      <path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.3-48.38-79.3-48.38 0-55.79 37.8-55.79 76.8V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"/>
    </svg>
  </a>
</nav>

<style>
  .profile-links { display: flex; gap: .875rem; }
  .profile-links a {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 44px; min-height: 44px; color: var(--secondary); font-size: .9rem;
    white-space: nowrap;
  }
  .profile-links a:is(:hover, :focus-visible) { color: var(--accent); text-decoration: underline; text-underline-offset: .22em; }
  .profile-links .social-icon { display: none; }
  @container profile-intro (max-width: 21.5rem) {
    .profile-links { align-self: center; gap: .125rem; transform: translateY(6px); }
    .profile-links .social-label { display: none; }
    .profile-links .social-icon { display: block; }
    .profile-links a { border-radius: .5rem; }
    .profile-links a:is(:hover, :focus-visible) { background: var(--tint); }
  }
</style>
