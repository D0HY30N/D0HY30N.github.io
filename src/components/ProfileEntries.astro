---
import type { ProfileEntry } from "../data/profile";
interface Props { entries: ProfileEntry[]; }
const { entries } = Astro.props;
const dateLabel = (iso: string) => iso.slice(0, 7).replace("-", ".");
---
<ul class="entries">
  {entries.map(entry => <li>
    {"date" in entry ? (
      <div class="record award">
        <div class="award-heading">
          <strong>{entry.name}</strong>
          <span class:list={["prize", { participation: !entry.prize }]}>{entry.prize ?? "참여"}</span>
        </div>
        <div class="award-meta">
          <span class="award-date">
            <time datetime={entry.date}>{dateLabel(entry.date)}</time>
            {entry.endDate && <> – <time datetime={entry.endDate}>{dateLabel(entry.endDate)}</time></>}
          </span>
          {entry.organization && <span class="organization">{entry.organization}</span>}
        </div>
      </div>
    ) : "id" in entry ? (
      <a class="cve-link" href={"https://www.cve.org/CVERecord?id=" + entry.id}>
        <span class="cve-id">{entry.id}</span>
        {entry.product && <span class="product">{entry.product}</span>}
        <span class="link-arrow" aria-hidden="true">↗</span>
      </a>
    ) : "start" in entry ? (
      <div class="record position">
        <strong>{entry.name}</strong>
        <div class="period">
          <time datetime={entry.start}>{dateLabel(entry.start)}</time>
          <span> – </span>
          {entry.end ? <time datetime={entry.end}>{dateLabel(entry.end)}</time> : <span class="current">재직 중</span>}
        </div>
      </div>
    ) : (
      <div class="record qualification">
        {entry.acquired && <time class="period" datetime={entry.acquired}>{dateLabel(entry.acquired)}</time>}
        <strong>{entry.name}</strong>
      </div>
    )}
  </li>)}
</ul>

<style>
  .entries { padding: 0; list-style: none; }
  li + li { border-top: 1px solid color-mix(in srgb, var(--rule) 65%, transparent); }
  strong, .product { font-size: clamp(1.02rem, 1.6vw, 1.13rem); line-height: 1.5; font-weight: 600; letter-spacing: -.02em; }
  .record, .cve-link {
    display: grid; grid-template-columns: var(--record-rail) minmax(0, 1fr);
    align-items: baseline; column-gap: var(--record-gap); padding-block: 1.1rem;
  }
  .award-date, .period, .organization { color: var(--secondary); font-size: .86rem; line-height: 1.65; }
  time { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .award-meta { display: contents; }
  .award-date { grid-column: 1; grid-row: 1; }
  .award-heading {
    grid-column: 2; grid-row: 1; display: grid; grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline; column-gap: var(--record-gap);
  }
  .award-heading strong { letter-spacing: -.01em; }
  .prize {
    display: inline-block; padding: .05rem .45rem; border-radius: .3rem;
    background: var(--tint); color: var(--accent); font-size: .79rem; line-height: 1.6;
    font-weight: 650; white-space: nowrap;
  }
  .organization { grid-column: 2; margin-top: .2rem; }
  .participation { background: color-mix(in srgb, var(--secondary) 12%, var(--paper)); color: var(--secondary); }
  .current { white-space: nowrap; }
  .cve-link {
    grid-template-columns: var(--record-rail) minmax(0, 1fr) auto;
    min-height: 3.45rem; padding-block: .9rem; border-radius: .3rem;
  }
  .cve-id { color: var(--accent); font: 550 .92rem/1.5 var(--font-mono); }
  .link-arrow { grid-column: -2; color: var(--secondary); line-height: 1; }
  .cve-link:is(:hover, :focus-visible) {
    background: color-mix(in srgb, var(--tint) 65%, transparent); color: var(--ink);
  }
  .cve-link:is(:hover, :focus-visible) .cve-id { text-decoration: underline; text-underline-offset: .22em; }
  .qualification strong:only-child { grid-column: 1 / -1; }

  @media (width > 40rem) {
    .position .period { grid-row: 1; grid-column: 1; }
  }

  @media (max-width: 40rem) {
    .record { grid-template-columns: minmax(0, 1fr); gap: .25rem; padding-block: .9rem; }
    .award-heading { grid-column: 1; column-gap: .6rem; }
    .award-heading strong { text-wrap: balance; }
    .award-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: .15rem .45rem; }
    .organization { margin-top: 0; }
    .organization::before { content: "·"; margin-inline-end: .45rem; }
    .qualification strong { grid-row: 1; }
    .cve-link { grid-template-columns: minmax(0, 1fr) auto; row-gap: .15rem; }
    .product { grid-column: 1; grid-row: 2; font-size: .95rem; }
    .link-arrow { grid-row: 1 / 3; align-self: center; }
    .cve-id { font-size: .9rem; }
  }
</style>
