---
import path from "node:path";

interface Props {
	id?: string;
	src: string;
	darkSrc?: string;
	class?: string;
	alt?: string;
	position?: string;
	basePath?: string;
}

import { Image } from "astro:assets";
import { url } from "../../utils/url-utils";

const { id, src, darkSrc, alt, position = "center", basePath = "/" } = Astro.props;
const className = Astro.props.class;

const isLocal = !(
	src.startsWith("/") ||
	src.startsWith("http") ||
	src.startsWith("https") ||
	src.startsWith("data:")
);
const isPublic = src.startsWith("/");
const isDarkLocal = !!darkSrc && !(
	darkSrc.startsWith("/") ||
	darkSrc.startsWith("http") ||
	darkSrc.startsWith("https") ||
	darkSrc.startsWith("data:")
);
const isDarkPublic = !!darkSrc && darkSrc.startsWith("/");

// TODO temporary workaround for images dynamic import
// https://github.com/withastro/astro/issues/3373
// biome-ignore lint/suspicious/noImplicitAnyLet: <check later>
let img;
let darkImg;
if (isLocal) {
	const files = import.meta.glob<ImageMetadata>("../../**", {
		import: "default",
	});
	let normalizedPath = path
		.normalize(path.join("../../", basePath, src))
		.replace(/\\/g, "/");
	const file = files[normalizedPath];
	if (!file) {
		console.error(
			`\n[ERROR] Image file not found: ${normalizedPath.replace("../../", "src/")}`,
		);
	}
	img = await file();

	if (isDarkLocal && darkSrc) {
		const normalizedDarkPath = path
			.normalize(path.join("../../", basePath, darkSrc))
			.replace(/\\/g, "/");
		const darkFile = files[normalizedDarkPath];
		if (!darkFile) {
			console.error(
				`\n[ERROR] Image file not found: ${normalizedDarkPath.replace("../../", "src/")}`,
			);
		} else {
			darkImg = await darkFile();
		}
	}
}

const imageClass = "w-full h-full object-cover";
const lightImageClass = `${imageClass} ${darkSrc ? "dark:hidden" : ""}`;
const darkImageClass = `${imageClass} hidden dark:block`;
const imageStyle = `object-position: ${position}`;
---
<div id={id} class:list={[className, 'overflow-hidden relative']}>
    <div class="transition absolute inset-0 dark:bg-black/10 bg-opacity-50 pointer-events-none"></div>
    {isLocal && img && <Image src={img} alt={alt || ""} class={lightImageClass} style={imageStyle}/>}
    {!isLocal && <img src={isPublic ? url(src) : src} alt={alt || ""} class={lightImageClass} style={imageStyle}/>}
    {darkSrc && isDarkLocal && darkImg && <Image src={darkImg} alt={alt || ""} class={darkImageClass} style={imageStyle}/>}
    {darkSrc && !isDarkLocal && <img src={isDarkPublic ? url(darkSrc) : darkSrc} alt={alt || ""} class={darkImageClass} style={imageStyle}/>}
</div>
