---
import { Icon } from "astro-icon/components";
import { licenseConfig, profileConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	class: string;
}

const { title, pubDate } = Astro.props;
const className = Astro.props.class;
const profileConf = profileConfig;
const licenseConf = licenseConfig;
const postUrl = decodeURIComponent(Astro.url.toString());
---
<div class={`relative h-[96px] overflow-hidden border border-black/5 bg-[var(--license-block-bg)] px-4 py-3 transition dark:border-white/10 sm:px-5 ${className}`}>
    <div class="relative z-10 min-w-0 pr-12">
        <div class="truncate text-sm font-semibold text-black/75 transition dark:text-white/75" title={title}>
            {title}
        </div>
        <a href={postUrl} title={postUrl} class="link mt-0.5 inline-block max-w-full truncate align-bottom text-sm text-[var(--primary)]">
            {postUrl}
        </a>
    </div>

    <dl class="relative z-10 mt-1.5 grid grid-cols-3 overflow-hidden text-[10px] leading-3 sm:mt-2 sm:flex sm:flex-nowrap sm:items-baseline sm:gap-x-5 sm:whitespace-nowrap sm:text-xs sm:leading-4">
        <div class="min-w-0 pr-1 text-center sm:flex sm:shrink-0 sm:items-baseline sm:gap-1.5 sm:pr-0 sm:text-left">
            <dt class="truncate text-black/30 transition dark:text-white/30">{i18n(I18nKey.author)}</dt>
            <dd class="truncate text-black/70 transition dark:text-white/70" title={profileConf.name}>{profileConf.name}</dd>
        </div>
        <div class="min-w-0 border-l border-black/10 px-1 text-center dark:border-white/10 sm:flex sm:shrink-0 sm:items-baseline sm:gap-1.5 sm:border-l-0 sm:px-0 sm:text-left">
            <dt class="truncate text-black/30 transition dark:text-white/30">{i18n(I18nKey.publishedAt)}</dt>
            <dd class="truncate text-black/70 transition dark:text-white/70" title={formatDateToYYYYMMDD(pubDate)}>{formatDateToYYYYMMDD(pubDate)}</dd>
        </div>
        <div class="min-w-0 border-l border-black/10 pl-1 text-center dark:border-white/10 sm:flex sm:shrink-0 sm:items-baseline sm:gap-1.5 sm:border-l-0 sm:pl-0 sm:text-left">
            <dt class="truncate text-black/30 transition dark:text-white/30">{i18n(I18nKey.license)}</dt>
            <dd class="truncate" title={licenseConf.name}>
                <a href={licenseConf.url} target="_blank" rel="license noopener noreferrer" class="link text-[var(--primary)]">
                    {licenseConf.name}
                </a>
            </dd>
        </div>
    </dl>

    <Icon name="fa6-brands:creative-commons" class="pointer-events-none absolute right-3 top-1/2 text-[136px] text-black/[0.035] transition -translate-y-1/2 dark:text-white/[0.04]"></Icon>
</div>
