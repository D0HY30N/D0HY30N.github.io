---
import { Icon } from "astro-icon/components";
import { licenseConfig, profileConfig } from "../../config";
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";

interface Props {
	title: string;
	slug: string;
	pubDate: Date;
	class: string;
}

const { title, pubDate } = Astro.props;
const className = Astro.props.class;
const profileConf = profileConfig;
const licenseConf = licenseConfig;
const postUrl = decodeURIComponent(Astro.url.toString());
---
<div class={`relative h-[96px] overflow-hidden border border-black/5 bg-[var(--license-block-bg)] px-4 py-3 transition dark:border-white/10 sm:px-5 ${className}`}>
    <div class="relative z-10 min-w-0 pr-12">
        <div class="truncate text-sm font-semibold text-black/75 transition dark:text-white/75" title={title}>
            {title}
        </div>
        <a href={postUrl} title={postUrl} class="link mt-0.5 inline-block max-w-full truncate align-bottom text-sm text-[var(--primary)]">
            {postUrl}
        </a>
    </div>

    <dl class="relative z-10 mt-2 flex flex-nowrap items-baseline gap-x-2 overflow-hidden whitespace-nowrap text-xs leading-4 sm:gap-x-5">
        <div class="flex min-w-0 shrink-0 items-baseline gap-1.5">
            <dt class="sr-only text-black/30 transition dark:text-white/30 sm:not-sr-only">{i18n(I18nKey.author)}</dt>
            <dd class="truncate text-black/70 transition dark:text-white/70">{profileConf.name}</dd>
        </div>
        <div class="flex min-w-0 shrink-0 items-baseline gap-1.5 border-l border-black/10 pl-2 dark:border-white/10 sm:border-l-0 sm:pl-0">
            <dt class="sr-only text-black/30 transition dark:text-white/30 sm:not-sr-only">{i18n(I18nKey.publishedAt)}</dt>
            <dd class="truncate text-black/70 transition dark:text-white/70">{formatDateToYYYYMMDD(pubDate)}</dd>
        </div>
        <div class="flex min-w-0 shrink-0 items-baseline gap-1.5 border-l border-black/10 pl-2 dark:border-white/10 sm:border-l-0 sm:pl-0">
            <dt class="sr-only text-black/30 transition dark:text-white/30 sm:not-sr-only">{i18n(I18nKey.license)}</dt>
            <dd class="truncate">
                <a href={licenseConf.url} target="_blank" rel="license noopener noreferrer" class="link text-[var(--primary)]">
                    {licenseConf.name}
                </a>
            </dd>
        </div>
    </dl>

    <Icon name="fa6-brands:creative-commons" class="pointer-events-none absolute right-3 top-1/2 text-[136px] text-black/[0.035] transition -translate-y-1/2 dark:text-white/[0.04]"></Icon>
</div>
