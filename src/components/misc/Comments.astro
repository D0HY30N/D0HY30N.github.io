---
import { Icon } from "astro-icon/components";
---

<section
	aria-labelledby="comments-title"
	class="card-base mb-4 px-5 py-5 md:px-7 md:py-6 onload-animation"
>
	<header class="flex min-h-10 items-center gap-3 mb-5">
		<div
			class="flex items-center justify-center size-10 shrink-0 rounded-xl bg-[var(--btn-plain-bg-hover)] text-[var(--primary)]"
		>
			<Icon name="material-symbols:chat-bubble-outline-rounded" class="text-[1.35rem]" />
		</div>
		<h2
			id="comments-title"
			class="flex h-10 items-center text-xl font-bold leading-none text-black/85 dark:text-white/85"
		>
			Comment
		</h2>
	</header>

	<div class="h-px bg-black/[0.07] dark:bg-white/10 mb-5"></div>

	<giscus-comments class="block" data-light-theme="noborder_light" data-dark-theme="transparent_dark">
		<div class="giscus min-h-24" aria-live="polite"></div>
	</giscus-comments>
</section>

<script>
	class GiscusComments extends HTMLElement {
		private themeObserver?: MutationObserver;

		connectedCallback() {
			if (this.querySelector("iframe.giscus-frame")) return;

			const container = this.querySelector(".giscus");
			if (!container) return;

			const getTheme = () =>
				document.documentElement.classList.contains("dark")
					? this.dataset.darkTheme || "transparent_dark"
					: this.dataset.lightTheme || "noborder_light";

			const script = document.createElement("script");
			script.src = "https://giscus.app/client.js";
			script.async = true;
			script.crossOrigin = "anonymous";
			script.dataset.repo = "D0HY30N/D0HY30N.github.io";
			script.dataset.repoId = "R_kgDOTubuvQ";
			script.dataset.category = "Announcements";
			script.dataset.categoryId = "DIC_kwDOTubuvc4DCtOx";
			script.dataset.mapping = "pathname";
			script.dataset.strict = "1";
			script.dataset.reactionsEnabled = "1";
			script.dataset.emitMetadata = "0";
			script.dataset.inputPosition = "bottom";
			script.dataset.theme = getTheme();
			script.dataset.lang = "ko";
			script.dataset.loading = "lazy";
			container.appendChild(script);

			this.themeObserver = new MutationObserver(() => {
				const iframe = this.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
				iframe?.contentWindow?.postMessage(
					{
						giscus: {
							setConfig: { theme: getTheme() },
						},
					},
					"https://giscus.app",
				);
			});

			this.themeObserver.observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["class"],
			});
		}

		disconnectedCallback() {
			this.themeObserver?.disconnect();
		}
	}

	if (!customElements.get("giscus-comments")) {
		customElements.define("giscus-comments", GiscusComments);
	}
</script>

<style>
	.giscus,
	.giscus-frame {
		width: 100%;
	}
</style>
