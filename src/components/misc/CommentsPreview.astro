---
import { Icon } from "astro-icon/components";
---

<!--
  Temporary visual preview for the future giscus integration.
  Removing the component from the post page removes the entire preview.
-->
<section
	aria-labelledby="comments-preview-title"
	class="card-base mb-4 px-5 py-5 md:px-7 md:py-6 onload-animation"
>
	<header class="flex min-h-10 items-center justify-between gap-4 mb-5">
		<div class="flex items-center gap-3 min-w-0">
			<div
				class="flex items-center justify-center size-10 shrink-0 rounded-xl bg-[var(--btn-plain-bg-hover)] text-[var(--primary)]"
			>
				<Icon name="material-symbols:chat-bubble-outline-rounded" class="text-[1.35rem]" />
			</div>
			<h2
				id="comments-preview-title"
				class="flex h-10 items-center text-xl font-bold leading-none text-black/85 dark:text-white/85"
			>
				Comment
			</h2>
		</div>
		<span
			class="shrink-0 rounded-lg bg-black/[0.045] dark:bg-white/[0.07] px-2 py-1 text-[0.68rem] font-medium tracking-wide text-black/40 dark:text-white/45"
		>
			PREVIEW
		</span>
	</header>

	<div class="h-px bg-black/[0.07] dark:bg-white/10 mb-5"></div>

	<div class="flex flex-wrap items-center gap-2 mb-4" aria-label="댓글 반응 미리보기">
		{[
			["👍", "0"],
			["😄", "0"],
			["🎉", "0"],
			["❤️", "0"],
		].map(([emoji, count]) => (
			<span
				class="inline-flex h-8 items-center gap-1.5 rounded-lg border border-black/[0.07] dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.025] px-2.5 text-sm text-black/55 dark:text-white/55"
			>
				<span aria-hidden="true">{emoji}</span>
				<span class="text-xs tabular-nums">{count}</span>
			</span>
		))}
	</div>

	<div
		class="rounded-xl border border-black/[0.08] dark:border-white/[0.11] bg-black/[0.018] dark:bg-white/[0.025] px-4 py-4"
	>
		<div class="flex items-start gap-3">
			<div
				class="flex size-8 shrink-0 items-center justify-center rounded-full bg-black/[0.06] dark:bg-white/10 text-black/40 dark:text-white/45"
			>
				<Icon name="fa6-brands:github" class="text-[1rem]" />
			</div>
			<div class="min-w-0 flex-1">
				<div class="text-sm font-medium text-black/70 dark:text-white/70">
					GitHub로 로그인하여 댓글 남기기
				</div>
				<div class="mt-1 text-xs leading-relaxed text-black/40 dark:text-white/40">
					댓글은 GitHub Discussions에 안전하게 저장됩니다.
				</div>
				<button
					type="button"
					disabled
					class="mt-3 inline-flex h-9 cursor-default items-center gap-2 rounded-lg bg-[var(--primary)] px-3.5 text-sm font-medium text-white opacity-80"
				>
					<Icon name="fa6-brands:github" class="text-[0.9rem]" />
					댓글 작성하기
				</button>
			</div>
		</div>
	</div>
</section>
