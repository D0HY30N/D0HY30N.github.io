---
import type { MarkdownHeading } from "astro";
interface Props { headings: MarkdownHeading[]; }
const { headings } = Astro.props;
const firstLevel = Math.min(...headings.map(heading => heading.depth));
---
<ul class="contents-links">
  {headings.map(heading => <li style={{ paddingInlineStart: (heading.depth - firstLevel) * 0.75 + "rem" }}>
    <a href={"#" + heading.slug}>{heading.text}</a>
  </li>)}
</ul>
