---
interface Props {
	path: string[];
	total: number;
}

const { path, total } = Astro.props;
---

<!-- Heading-to-post gap: 25.65px to 24.37px (5% less at the default font size). -->
<header class="pl-6 pr-6 md:pl-4 md:pr-9 pt-4 pb-2 -mb-[0.727rem] onload-animation">
    <h1 class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-4xl font-bold leading-relaxed text-90">
        {path.map((name, index) => (
            <>
                {index > 0 && <span aria-hidden="true" class="mx-[2px] text-50 font-normal">&gt;</span>}
                <span>{name}</span>
            </>
        ))}
        <span class="relative -top-[2px] text-lg font-normal tabular-nums text-50">{`(${total})`}</span>
    </h1>
</header>
