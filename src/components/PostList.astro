---
import { dateLabel, postUrl, type Post } from "../lib/posts";
interface Props { posts: Post[]; }
const { posts } = Astro.props;
---
{posts.length ? <ul class="post-list">
  {posts.map(post => <li>
    <a class="post-row" href={postUrl(post)}>
      <div>
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <div class="meta"><span>{post.data.category}</span><time datetime={post.data.published.toISOString()}>{dateLabel(post.data.published)}</time></div>
      </div>
      <span class="row-arrow" aria-hidden="true">↗</span>
    </a>
  </li>)}
</ul> : <p class="empty">아직 공개된 글이 없어요.</p>}
