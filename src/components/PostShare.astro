---
import { Icon } from "astro-icon/components";

interface Props {
	url: string;
}

const { url } = Astro.props;
---

<post-share data-pagefind-ignore class="block max-w-full">
    <div class="flex justify-end">
        <button type="button" data-copy-link disabled aria-label="게시글 공유하기: URL 복사" title="URL 복사"
            class="share-button h-8 rounded-md active:scale-95">
            <span data-link-icon aria-hidden="true"><Icon name="material-symbols:link-rounded" class="text-2xl -rotate-45" /></span>
            <span data-success-icon aria-hidden="true" hidden><Icon name="material-symbols:check-rounded" class="text-2xl" /></span>
            <span>공유하기</span>
        </button>
    </div>
    <span data-copy-status class="sr-only" role="status" aria-live="polite" aria-atomic="true"></span>
    <div data-copy-fallback class="share-fallback" hidden>
        <label class="block text-sm text-50">
            주소를 선택해서 복사해 주세요.
            <input data-share-url type="url" readonly value={url} aria-label="게시글 주소" />
        </label>
    </div>
</post-share>

<style>
    [hidden] { display: none !important; }
    .share-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        padding: 0;
        background: transparent;
        color: #6b7785;
        font-size: 1rem;
        font-weight: 500;
        white-space: nowrap;
        transition: color 150ms ease, transform 150ms ease;
    }
    :global(.dark) .share-button { color: #a5b0bd; }
    .share-button:hover, .share-button:active { color: var(--primary); }
    button:focus-visible, input:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 3px;
    }
    .share-fallback {
        width: min(22rem, calc(100vw - 4.5rem));
        max-width: 100%;
        margin-top: 0.75rem;
    }
    input {
        width: 100%;
        margin-top: 0.5rem;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--line-divider);
        border-radius: 0.5rem;
        background: var(--card-bg);
        color: var(--primary);
        font-size: 0.875rem;
    }
</style>

<script>
class PostShare extends HTMLElement {
    private controller?: AbortController;
    private resetTimer?: number;

    connectedCallback() {
        this.controller?.abort();
        window.clearTimeout(this.resetTimer);
        const controller = new AbortController();
        this.controller = controller;

        const button = this.querySelector<HTMLButtonElement>("[data-copy-link]")!;
        const linkIcon = this.querySelector<HTMLElement>("[data-link-icon]")!;
        const successIcon = this.querySelector<HTMLElement>("[data-success-icon]")!;
        const status = this.querySelector<HTMLElement>("[data-copy-status]")!;
        const fallback = this.querySelector<HTMLElement>("[data-copy-fallback]")!;
        const input = this.querySelector<HTMLInputElement>("[data-share-url]")!;

        const reset = () => {
            button.title = "URL 복사";
            linkIcon.hidden = false;
            successIcon.hidden = true;
            status.textContent = "";
        };

        reset();
        fallback.hidden = true;
        button.disabled = false;
        input.addEventListener("focus", () => input.select(), { signal: controller.signal });

        button.addEventListener("click", async () => {
            window.clearTimeout(this.resetTimer);
            reset();
            fallback.hidden = true;
            button.disabled = true;
            const shareUrl = window.location.href;
            input.value = shareUrl;
            try {
                await navigator.clipboard.writeText(shareUrl);
                if (controller.signal.aborted) return;
                button.title = "복사 완료";
                linkIcon.hidden = true;
                successIcon.hidden = false;
                status.textContent = "게시글 링크를 복사했어요.";
                this.resetTimer = window.setTimeout(reset, 2200);
            } catch {
                if (controller.signal.aborted) return;
                fallback.hidden = false;
                status.textContent = "게시글 주소를 선택해서 직접 복사해 주세요.";
                input.focus({ preventScroll: true });
                input.select();
            } finally {
                if (!controller.signal.aborted) button.disabled = false;
            }
        }, { signal: controller.signal });
    }

    disconnectedCallback() {
        this.controller?.abort();
        window.clearTimeout(this.resetTimer);
    }
}

if (!customElements.get("post-share")) {
    customElements.define("post-share", PostShare);
}
</script>
